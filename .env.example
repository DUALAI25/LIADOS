# === Desliado — Environment Variables ===

# ============================================
# PostgreSQL — Conexión a la base de datos
# Variables OBLIGATORIAS (sin defaults en el código por seguridad)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desliado
DB_USER=desliado
DB_PASSWORD=tu_password_aqui
# ============================================
# MinIO — Almacenamiento de PDFs de facturas
# (Opcional: si no se configura, usa filesystem local en DATA_DIR)
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_...n
# ============================================
# Almacenamiento local — Ruta donde se guardan adjuntos descargados
# En local: /home/openclaw/liados/data
# En VPS:   /root/liados/data
# ============================================
DATA_DIR=/root/liados/data

# ============================================
# Gmail API — Captura de facturas por email
# MULTI-CUENTA: el cliente puede tener N Gmail
# ============================================
# Ventana inicial para la primera sincronizacion de Gmail (en dias).
# Despues se hace incremental desde get_last_sync('gmail').
GMAIL_INITIAL_DAYS=30
# Lista de cuentas a procesar (separadas por coma)
GMAIL_ACCOUNTS=principal,secundaria

# Para cada cuenta X, necesitas estas 2 variables:
#   GMAIL_CREDENTIALS_FILE_X  = ruta al JSON de credenciales OAuth (Desktop o Web)
#   GMAIL_TOKEN_FILE_X        = donde se guardará el token tras autorizar

# Cuenta principal
GMAIL_CREDENTIALS_FILE_principal=agente/credentials/gmail_credentials_principal.json
GMAIL_TOKEN_FILE_principal=agente/credentials/gmail_token_principal.json

# Cuenta secundaria
GMAIL_CREDENTIALS_FILE_secundaria=agente/credentials/gmail_credentials_secundaria.json
GMAIL_TOKEN_FILE_secundaria=agente/credentials/gmail_token_secundaria.json

# Flujo de autorización (solo primera vez):
#   python3 agente/scripts/gmail_auth.py --account principal
#   python3 agente/scripts/gmail_auth.py --account secundaria

# ============================================
# OpenCode Go — Parseo de facturas con IA
# ============================================
OPENCODE_API_KEY=sk-tu_api_key_aqui
# ============================================
# Lastapp API v2 — Sincronización de facturas emitidas
# DEPRECATED: usado solo por lastapp_sync.py (legacy).
# Para el MCP oficial, usa OAuth (ver sección 'Last.app MCP setup' en README).
# ============================================
LASTAPP_API_URL=https://api.last.app/v2
LASTAPP_API_TOKEN=tu_token_aqui
LASTAPP_ORGANIZATION_ID=
LASTAPP_LOCATION_ID=

# ============================================
# Last.app MCP oficial (https://api.last.app/mcp)
# Obtener client_id/secret contactando a soporte@last.app o en admin.last.app
# Doc: https://www.last.app/actualizaciones-de-producto/last-app-mcp-conecta-tu-ia-con-tu-restaurante
# ============================================
# Método A — Token Bearer directo (recomendado para empezar)
# Si tienes un token Bearer (obtenido de Claude Desktop, Cursor, o setup manual):
LASTAPP_OAUTH_BEARER_TOKEN=

# Método B — OAuth authorization_code (flujo interactivo)
# LASTAPP_OAUTH_CLIENT_ID=
# LASTAPP_OAUTH_CLIENT_SECRET=
# LASTAPP_OAUTH_TOKEN_URL=https://api.last.app/mcp/token
# LASTAPP_OAUTH_AUTHORIZE_URL=https://api.last.app/mcp/authorize
# LASTAPP_OAUTH_SCOPE=mcp:read mcp:write
# LASTAPP_OAUTH_REDIRECT_URI=http://localhost:9999/callback

# ============================================
# Telegram — Alertas y resúmenes (OPCIONAL)
# ============================================
# Si no se configura, el sistema funciona sin Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id
# ============================================
# Dashboard — Auth básica HTTP
# ============================================
DASHBOARD_USER=jefe
DASHBOARD_PASSWORD=jefe2026
