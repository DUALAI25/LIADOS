# === Desliado — Environment Variables ===

# ============================================
# PostgreSQL — Conexión a la base de datos
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desliado
DB_USER=desliado
DB_PASSWORD=desliado_pass_2026
DATABASE_URL=postgresql://desliado:desliado_pass_2026@localhost:5432/desliado

# ============================================
# MinIO — Almacenamiento de PDFs de facturas
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_pass_2026
MINIO_BUCKET=invoices
MINIO_USE_SSL=false

# ============================================
# Almacenamiento local — Ruta dentro del contenedor
# ============================================
DATA_DIR=/home/node/.openclaw/workspace-desliado/data

# ============================================
# Gmail API — Captura de facturas por email
# ============================================
# Cómo obtenerlas:
#   1. Ve a https://console.cloud.google.com/
#   2. Crea proyecto → Habilita Gmail API
#   3. Credenciales → OAuth 2.0 → Aplicación de escritorio
#   4. Descarga el JSON y guárdalo como:
#      agente/credentials/gmail_credentials.json
#   5. Ejecuta: python3 scripts/setup_gmail_auth.py
#      (esto genera automáticamente gmail_token.json)
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=

# ============================================
# OpenCode Go — Parseo de facturas con IA
# ============================================
# Cómo obtenerla:
#   1. Ve a https://opencode.ai/zen
#   2. Crea cuenta / inicia sesión
#   3. Genera una API key desde la consola
#   4. Cópiala aquí
# Modelos disponibles: deepseek-v4-flash (barato), deepseek-v4-pro (calidad)
# Compatible con OpenAI SDK
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# ============================================
# Lastapp — Sincronización de facturas emitidas
# ============================================
# Cómo obtener el token:
#   1. Ve a https://developers.last.app/
#   2. Regístrate como integrator
#   3. Crea un token para la organización del cliente
# La URL base de la API v2:
LASTAPP_API_URL=https://api.last.app/v2
LASTAPP_API_TOKEN=

# ============================================
# Telegram — Alertas y resúmenes
# ============================================
# Cómo crear el bot:
#   1. Busca @BotFather en Telegram
#   2. Envía: /newbot → ponle nombre → obtienes el token
#   3. Para obtener el chat_id:
#      - Envía un mensaje al bot
#      - Ve a: https://api.telegram.org/bot<TOKEN>/getUpdates
#      - Copia el chat_id de la respuesta
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
