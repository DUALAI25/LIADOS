# === Desliado — Environment Variables ===

# ============================================
# PostgreSQL — Conexión a la base de datos
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desliado
DB_USER=desliado
DB_PASSWORD=deslia...n
# ============================================
# MinIO — Almacenamiento de PDFs de facturas
# (Opcional: si no se configura, usa filesystem local en DATA_DIR)
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_...n
# ============================================
# Almacenamiento local — Ruta donde se guardan los PDFs
# ============================================
DATA_DIR=/home/openclaw/liados/data

# ============================================
# Gmail API — Captura de facturas por email
# MULTI-CUENTA: el cliente puede tener N Gmail
# ============================================
# Lista de cuentas a procesar (separadas por coma)
GMAIL_ACCOUNTS=principal,secundaria

# Para cada cuenta X, necesitas estas 2 variables:
#   GMAIL_CREDENTIALS_FILE_X  = ruta al JSON de credenciales OAuth (Desktop o Web)
#   GMAIL_TOKEN_FILE_X        = donde se guardará el token tras autorizar

# Cuenta principal
GMAIL_CREDENTIALS_FILE_principal=agente/credentials/gmail_credentials_principal.json
GMAIL_TOKEN_FILE_principal=agente/credentials/gmail_token_principal.json

# Cuenta secundaria
GMAIL_CREDENTIALS_FILE_secundaria=agente/credentials/gmail_credentials_secundaria.json
GMAIL_TOKEN_FILE_secundaria=agente/credentials/gmail_token_secundaria.json

# Flujo de autorización (solo primera vez):
#   python3 agente/scripts/gmail_auth.py --account principal
#   python3 agente/scripts/gmail_auth.py --account secundaria

# ============================================
# OpenCode Go — Parseo de facturas con IA
# ============================================
OPENCODE_API_KEY=sk-tu_api_key_aqui
# ============================================
# Lastapp — Sincronización de facturas emitidas
# ============================================
LASTAPP_API_URL=https://api.last.app/v2
LASTAPP_API_TOKEN=tu_token_aqui
# ============================================
# Telegram — Alertas y resúmenes (OPCIONAL)
# ============================================
# Si no se configura, el sistema funciona sin Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id
